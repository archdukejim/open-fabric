services:
  keycloak:
    # Pre-built (optimized) local layer: no re-augmentation at start, so the
    # root filesystem can be read-only (see build/Dockerfile).
{% set published = published_ref('keycloak') %}
    # fabric's published image when this host can use it, else its own build (manual 2.6.3.3)
    image: {{ published or 'fabric/keycloak:local' }}
{% if not published %}
    build:
      context: {{ deploy_base_dir }}/keycloak/build
      args:
        BASE_IMAGE: "{{ image_keycloak }}"
{% endif %}
    container_name: keycloak
    # to the host journal (fabric-web, openbao, … by name): `docker logs` still works,
    # and the optional log forwarder reads everything from one place
    logging:
      driver: journald
      options:
        tag: "{{ '{{.Name}}' }}"
    user: "{{ service_users.keycloak.uid }}:{{ service_users.keycloak.gid }}"
    command: ["start", "--optimized"]
    read_only: true
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    tmpfs:
      - /tmp:nosuid,size=64m
    environment:
      KC_DB_URL: jdbc:postgresql://postgres:5432/keycloak?sslmode=verify-full&sslrootcert=/etc/keycloak/certs/root_ca.crt
      KC_DB_USERNAME: keycloak
      KC_DB_PASSWORD: "{{ keycloak_db_password }}"
      KC_HOSTNAME: "{{ hostname_keycloak }}"
      KC_PROXY_HEADERS: xforwarded
      KC_HTTP_ENABLED: "true"
      KC_HTTPS_CERTIFICATE_FILE: /etc/keycloak/certs/fullchain.pem
      KC_HTTPS_CERTIFICATE_KEY_FILE: /etc/keycloak/certs/privkey.pem
      KC_TRUSTSTORE_PATHS: /etc/keycloak/certs/root_ca.crt
      # Bootstrap admin (Keycloak 26+ names; KEYCLOAK_ADMIN* are deprecated)
      KC_BOOTSTRAP_ADMIN_USERNAME: "{{ keycloak_admin_user }}"
      KC_BOOTSTRAP_ADMIN_PASSWORD: "{{ keycloak_admin_password }}"
{% set kc_mem = (1200 * ((host_ram_capacity | default(4) | int) / 4)) | int %}
      JAVA_OPTS_APPEND: "-Xmx{{ (kc_mem * 0.8) | int }}m -Djava.security.krb5.conf=/etc/keycloak/kerberos/krb5.conf"
    volumes:
      - {{ keycloak_data_dir }}:/opt/keycloak/data
      - {{ deploy_base_dir }}/keycloak/certs:/etc/keycloak/certs:ro
      # Kerberos sign-in (manual 5.8.2.6.2): the site's keytab and krb5.conf (install_sso_keytab); the folder is made
      # by setup before the first start, empty until the DC has exported the keytab
      - {{ deploy_base_dir }}/keycloak/kerberos:/etc/keycloak/kerberos:ro
    networks:
      fabric_net:
        ipv4_address: "{{ ip_keycloak }}"
        aliases:
          - "{{ hostname_keycloak }}"
          - "keycloak"
    restart: unless-stopped
{% set kc_mem = (1200 * ((host_ram_capacity | default(4) | int) / 4)) | int %}
    deploy:
      resources:
        limits:
          memory: {{ kc_mem }}M
    healthcheck:
      test: ["CMD-SHELL", "bash -c 'exec 3<>/dev/tcp/127.0.0.1/9000'"]
      interval: 15s
      timeout: 5s
      retries: 20
      start_period: 120s

networks:
  fabric_net:
    name: fabric_net
    external: true
