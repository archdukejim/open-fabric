// fabric's DNS filter: the BIND resolver (manual 1.12.2). Rendered at every apply: do not edit here.
include "/etc/bind/rndc.key";
controls { inet 127.0.0.1 port 953 allow { 127.0.0.1; } keys { "rndc-key"; }; };

{% for name in upstream_names %}
tls "upstream-{{ loop.index }}" { remote-hostname "{{ name }}"; ca-file "/etc/ssl/certs/ca-certificates.crt"; };
{% endfor %}
{% if client_tls %}
// DNS-over-TLS and DNS-over-HTTPS for clients (manual 1.12.2.16): the DNS name's certificate
tls "clients" { cert-file "/etc/bind-tls/fullchain.pem"; key-file "/etc/bind-tls/privkey.pem"; protocols { TLSv1.2; TLSv1.3; }; };
http "doh" { endpoints { "/dns-query"; }; };
{% endif %}
// the networks that may use it: the LAN, fabric's own, and what the firewall lets in
acl "clients" { {% for c in clients %}{{ c }}; {% endfor %}127.0.0.1; };

options {
    directory "/var/cache/bind";
    session-keyfile "/var/cache/bind/session.key";
    listen-on port 53 { any; };
{% if client_tls %}
    listen-on port 853 tls "clients" { any; };
    // DoH: nginx terminates TLS and passes cleartext HTTP/2 here (fabric_net only, not published)
    listen-on port 8053 tls none http "doh" { any; };
{% endif %}
    listen-on-v6 { none; };
    recursion yes;
    allow-query { clients; };
    allow-recursion { clients; };
    allow-query-cache { clients; };
    allow-transfer { none; };
{% if dns_filter_upstreams %}
    // DNS-over-TLS, the certificate's name verified (1.12.2.8)
    forward only;
    forwarders { {% for u in dns_filter_upstreams %}{{ u.address }} port 853 tls "upstream-{{ upstream_names.index(u.name) + 1 }}"; {% endfor %}};
{% endif %}
    dnssec-validation auto;
    // fabric's zones are private: no DNSSEC chain from the root leads to them
    validate-except { {% for z in zones %}"{{ z }}"; {% endfor %}};
    querylog yes;
    version none;
    hostname none;
    server-id none;
};

logging {
    channel default_out { stderr; severity info; print-time yes; print-category yes; print-severity yes; };
    channel queries { file "/var/log/named/query.log" versions 2 size 20m; print-time yes; };
    channel rpz { file "/var/log/named/rpz.log" versions 2 size 20m; print-time yes; };
    category default { default_out; };
    category queries { queries; };
    category rpz { rpz; };
    category lame-servers { null; };
};

{% for g in groups %}
// client group {{ g.name }} (manual 1.12.2.15): its own policy, then everything else through the main view
view "{{ g.name }}" {
    match-clients { {% for m in g.match %}{{ m }}; {% endfor %}};
    forward only;
    forwarders { 127.0.0.1 port 53; };
    // the main view validates what it answers (a group's DS lookups for a listed name would be blocked there)
    dnssec-validation no;
    // never cache a blocked answer here: every blocked query reaches the main view and is logged as blocked
    max-ncache-ttl 0;
{% for n in g.allow %}
    zone "{{ n }}" { type forward; forward only; forwarders { {% for u in dns_filter_upstreams %}{{ u.address }} port 853 tls "upstream-{{ upstream_names.index(u.name) + 1 }}"; {% endfor %}}; };
{% endfor %}
    zone "{{ g.rules_zone }}" { type primary; file "/etc/bind/{{ g.rules_zone }}"; };
{% if g.safe_zone %}
    zone "{{ g.safe_zone }}" { type primary; file "/etc/bind/{{ g.safe_zone }}"; };
{% endif %}
{% for l in g.lists %}
    zone "{{ l.zone }}" { type primary; file "/etc/bind-lists/{{ l.zone }}"; };  // {{ l.name | replace('*/', '') | replace('\n', ' ') }}
{% endfor %}
    response-policy {
        zone "{{ g.rules_zone }}";
{% if g.safe_zone %}
        zone "{{ g.safe_zone }}";
{% endif %}
{% for l in g.lists %}
        zone "{{ l.zone }}";
{% endfor %}
    } break-dnssec yes qname-wait-recurse no;
};

{% endfor %}
view "everyone" {
    match-clients { any; };
{% for z in zones %}
    zone "{{ z }}" { type forward; forward only; forwarders { {{ ip_bind9 }} port 53; }; };
{% endfor %}
    zone "fabric.rpz" { type primary; file "/etc/bind/fabric.rpz"; };
    zone "owner.rpz" { type primary; file "/etc/bind/owner.rpz"; };
{% if safe_zone %}
    zone "{{ safe_zone }}" { type primary; file "/etc/bind/{{ safe_zone }}"; };
{% endif %}
{% for l in lists %}
    zone "{{ l.zone }}" { type primary; file "/etc/bind-lists/{{ l.zone }}"; };  // {{ l.name | replace('*/', '') | replace('\n', ' ') }}
{% endfor %}
    // first match wins: fabric's zones are never filtered, then the owner's rules, safe search, the lists in order
    response-policy {
        zone "fabric.rpz";
        zone "owner.rpz";
{% if safe_zone %}
        zone "{{ safe_zone }}";
{% endif %}
{% for l in lists %}
        zone "{{ l.zone }}";
{% endfor %}
    } break-dnssec yes qname-wait-recurse no;
};
