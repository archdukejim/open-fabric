[Unit]
Description=fabric: the DNS filter's lists, daily (manual 1.12.2.10)

[Timer]
# a quiet hour after certificate renewal, spread so sites do not fetch at once; a night missed runs at the next boot
OnCalendar=*-*-* 04:15:00
RandomizedDelaySec=1800
Persistent=true

[Install]
WantedBy=timers.target
