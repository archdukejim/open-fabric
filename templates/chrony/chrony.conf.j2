# fabric: rendered by fabricctl (jinja/chrony/chrony.conf.j2, manual 2.5.1); apply overwrites edits.
# Sources: this site's upstream site first (federation), then ntp_servers.
{% for s in sources %}
{{ 'pool' if s.pool else 'server' }} {{ s.host }} iburst{{ ' nts' if s.nts }}{{ ' prefer' if s.prefer }}
{% endfor %}
{% if not sources %}
# no sources: this host's own clock only (see "local" below)
{% endif %}

driftfile /var/lib/chrony/chrony.drift
ntsdumpdir /var/lib/chrony
logdir /var/log/chrony
leapsectz right/UTC
maxupdateskew 100.0
# step the clock during the first updates (a Raspberry Pi boots with the time it shut down at)
makestep 1 3
rtcsync
# NTS certificates are checked once without their validity dates, so a host booting with a wrong clock can
# still reach an authenticated source (the time it then gets is checked by NTS itself)
nocerttimecheck 1

# chronyc only from this host
bindcmdaddress 127.0.0.1
bindcmdaddress ::1
{% if serve %}

# serve the network (ntp_serve): only these networks may ask, rate-limited
{% for net in allow %}
allow {{ net }}
{% endfor %}
ratelimit interval 1 burst 16
{% endif %}
# with no source reachable keep serving this host's steady clock, so the network stays consistent with itself;
# linked sites in the same state agree on one of them (orphan)
local stratum 10 orphan
