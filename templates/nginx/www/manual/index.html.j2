{% extends "../shared/base.html.j2" %}

{% block title %}{{ friendly_name | default(ca_name) }} &mdash; Infrastructure Manual{% endblock %}

{% block extra_head %}
  <script src="marked.min.js"></script>
  <script src="mermaid.min.js"></script>
  <script>
    if (typeof mermaid !== 'undefined') {
      mermaid.initialize({ startOnLoad: false });
    }
  </script>
{% endblock %}

{% block header_subtitle %}{{ friendly_name | default(ca_name) }} &mdash; Operations & Documentation{% endblock %}

{% block content %}
    <div class="tabs-wrapper">
      <div class="tabs" id="doc-tabs">
        <button class="tab" data-doc="README.md">Index</button>
        <button class="tab" data-doc="volume_1_description_and_architecture/README.md">1 Architecture</button>
        <button class="tab" data-doc="volume_2_engineering_decisions/README.md">2 Decisions</button>
        <button class="tab" data-doc="volume_3_installation/README.md">3 Installation</button>
        <button class="tab" data-doc="volume_4_operations/README.md">4 Operations</button>
      </div>
    </div>

    <div class="card active">
      <div id="markdown-content">
        <p>Loading the manual…</p>
      </div>
    </div>
{% endblock %}

{% block extra_scripts %}
  <script>
    // The manual (docs/, design: manual 2.3.1.3): docs/README.md is the master index, each volume has its own index,
    // and every subchapter links to others by relative path. Links are followed here, relative to the page shown.

    // GitHub's heading anchor, so the manual's #links land on their heading
    function slug(text) {
        return text.trim().toLowerCase().replace(/[^\w\- ]/g, '').replace(/ /g, '-');
    }

    function resolve(base, href) {
        const parts = base.split('/').slice(0, -1);
        for (const p of href.split('/')) {
            if (p === '..') parts.pop();
            else if (p !== '.' && p !== '') parts.push(p);
        }
        return parts.join('/');
    }

    function markTab(path) {
        const volume = path.split('/')[0];
        document.querySelectorAll('.tab').forEach(t => {
            const doc = t.getAttribute('data-doc');
            t.classList.toggle('active', doc === path || (doc.includes('/') && doc.split('/')[0] === volume));
        });
    }

    // push: a new browser-history entry (a click); false when the history itself moved (back, forward, a typed #)
    async function loadDoc(path, anchor, push = true) {
        markTab(path);
        const contentDiv = document.getElementById('markdown-content');
        contentDiv.innerHTML = '<p>Loading...</p>';
        try {
            const response = await fetch('docs/' + path);
            if (!response.ok) throw new Error('Network response was not ok');
            contentDiv.innerHTML = marked.parse(await response.text());
            contentDiv.querySelectorAll('h1, h2, h3, h4, h5, h6').forEach(h => { h.id = slug(h.textContent); });

            // Render mermaid diagrams
            contentDiv.querySelectorAll('pre code.language-mermaid').forEach(block => {
                const div = document.createElement('div');
                div.className = 'mermaid';
                div.textContent = block.textContent;
                block.parentElement.replaceWith(div);
            });
            if (typeof mermaid !== 'undefined') {
                try {
                    mermaid.init(undefined, contentDiv.querySelectorAll('.mermaid'));
                } catch (err) {
                    console.error('Mermaid rendering failed', err);
                }
            }

            // Follow links to other manual pages here; anchors scroll; everything else is left as it is
            contentDiv.querySelectorAll('a').forEach(a => {
                const href = a.getAttribute('href');
                if (!href || /^[a-z]+:/i.test(href)) return;
                const [file, frag] = href.split('#');
                if (!file) {
                    a.onclick = ev => { ev.preventDefault(); scrollToAnchor(frag); };
                } else if (file.endsWith('.md')) {
                    a.onclick = ev => { ev.preventDefault(); loadDoc(resolve(path, file), frag); };
                }
            });
            const hash = '#' + path + (anchor ? '#' + anchor : '');
            if (push && location.hash !== hash) history.pushState(null, '', hash);
            if (anchor) scrollToAnchor(anchor); else window.scrollTo(0, 0);
        } catch (error) {
            contentDiv.innerHTML = '<p style="color:var(--error);">Failed to load ' + path + '.</p>';
            console.error('Error fetching doc:', error);
        }
    }

    function scrollToAnchor(anchor) {
        const target = anchor && document.getElementById(anchor);
        if (target) target.scrollIntoView();
    }

    window.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.tab').forEach(t => {
            t.addEventListener('click', () => loadDoc(t.getAttribute('data-doc')));
        });
        // #<path>[#anchor] reopens the page that was shown (a reload, a shared link, back and forward)
        function fromHash(push) {
            const [path, anchor] = decodeURIComponent(location.hash.slice(1)).split('#');
            loadDoc(path && path.endsWith('.md') ? path : 'README.md', anchor, push);
        }
        window.addEventListener('popstate', () => fromHash(false));
        window.addEventListener('hashchange', () => fromHash(false));
        fromHash(false);
    });
  </script>
{% endblock %}
