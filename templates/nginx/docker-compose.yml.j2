services:
  nginx:
    image: {{ image_nginx }}
    container_name: nginx
    # to the host journal (fabric-web, openbao, … by name): `docker logs` still works,
    # and the optional log forwarder reads everything from one place
    logging:
      driver: journald
      options:
        tag: "{{ '{{.Name}}' }}"
    user: "{{ service_users.nginx.uid }}:{{ service_users.nginx.gid }}"
    security_opt:
      - no-new-privileges:true
    # No capabilities: Docker lets non-root bind low ports inside the
    # container's network namespace (ip_unprivileged_port_start=0).
    cap_drop:
      - ALL
    read_only: true
    tmpfs:
      - /tmp:noexec,nosuid,size=10m,uid={{ service_users.nginx.uid }},gid={{ service_users.nginx.gid }}
      - /var/cache/nginx:noexec,nosuid,size=50m,uid={{ service_users.nginx.uid }},gid={{ service_users.nginx.gid }}
      - /var/run:noexec,nosuid,size=5m,uid={{ service_users.nginx.uid }},gid={{ service_users.nginx.gid }}
      - /var/log/nginx:noexec,nosuid,size=5m,uid={{ service_users.nginx.uid }},gid={{ service_users.nginx.gid }}
    ports:
      - 80:80
      - "{{ host_ip }}:443:443"
{% if install_ldap | default(true) | bool and not install_samba | default(false) | bool %}
      # 389-DS through nginx; with the Windows domain on, its DC owns these ports (manual 2.11.2.4)
      - "{{ host_ip }}:389:389"
      - "{{ host_ip }}:636:636"
{% endif %}
    volumes:
      - {{ deploy_base_dir }}/nginx/config/nginx.conf:/etc/nginx/nginx.conf:ro
      - {{ deploy_base_dir }}/nginx/config/conf.d:/etc/nginx/conf.d:ro
      - {{ deploy_base_dir }}/nginx/certs:/etc/nginx/certs:ro
      - {{ deploy_base_dir }}/nginx/www:/srv/www:ro
{% if federation_endpoint | default(false) | bool %}
      # fabric-federation's unix socket (dir root:nginx 0750, socket 0660)
      - {{ deploy_base_dir }}/federation/run:/srv/federation:ro
{% endif %}
{% if install_webui | default(false) | bool %}
      # webui container's unix socket (dir webui:nginx 0750, socket 0660)
      - {{ deploy_base_dir }}/webui/run:/srv/webui:ro
{% endif %}
    networks:
      fabric_net:
        ipv4_address: "{{ ip_nginx }}"
        aliases:
          - "{{ hostname_nginx }}"
{% if (host_ram_capacity | default(0) | int) >= 3 and (host_ram_capacity | default(0) | int) <= 4 %}
{% set nginx_mem = 128 if (host_ram_capacity | default(0) | int) == 3 else 256 %}
    deploy:
      resources:
        limits:
          memory: {{ nginx_mem }}M
{% endif %}
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:80/"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s

networks:
  fabric_net:
    name: fabric_net
    external: true
