{
  "socket": "/run/webui/web.sock",
  "socket_gid": {{ service_users.nginx.gid }},
  "agent_socket": "/agent/agent.sock",
  "public_url": "https://{{ hostname_mgr }}",
  "ca_file": "/certs/root_ca.crt",
  "intermediate_ca": "/certs/intermediate_ca.crt",
  "admin_role": {{ webui_admin_role | to_json }},
  "client_cert": {{ webui_client_cert | default(false) | bool | to_json }},
  "session_idle": {{ webui_session_idle | default(900) | int }},
  "session_max": {{ webui_session_max | default(28800) | int }},
  "keycloak": {
    "ip": "{{ ip_keycloak }}",
    "port": 8443,
    "hostname": "{{ hostname_keycloak }}",
    "realm": {{ webui_realm | to_json }},
    "client_id": "fabric-webui",
    "client_secret": {{ webui_oidc_secret | to_json }}
  }
}
