---
# ============================================================
# RESOLVED VARS — auto-generated by 01-render-jinja.yml
# Sources: /custom-vars.yaml
#
# Do not edit directly — regenerated on every run of 01-render-jinja.yml.
# To change settings edit the source files above.
# ============================================================

# ============================================================
# GLOBAL
# ============================================================
domain: {{ domain }}
domain_file: {{ domain_file | default(domain | replace('.', '_')) }}
hostname: {{ hostname }}
friendly_name: {{ friendly_name | default("Example Org", true) }}
service_mark: {{ service_mark | default('null', true) }}
care_of: {{ care_of | default('null', true) }}
trademark: {{ trademark | default('null', true) }}
copyright: {{ copyright | default('null', true) }}
contact_email: {{ contact_email | default('null', true) }}
contact_phone: {{ contact_phone | default('null', true) }}
address_line1: {{ address_line1 | default('null', true) }}
address_line2: {{ address_line2 | default('null', true) }}
system_timezone: {{ system_timezone | default('America/New_York') }}
deploy_base_dir: {{ deploy_base_dir | default('/opt') }}

# ============================================================
# NETWORK
# ============================================================
lan_cidr: {{ lan_cidr }}
lan_gateway: {{ lan_gateway }}
dns_server: {{ dns_server | default('8.8.8.8') }}
use_host_dns: {{ use_host_dns | default(true) | lower }}
fabric_subnet: {{ fabric_subnet | default('10.255.0.0/24') }}
host_ip: {{ host_ip }}

# ============================================================
# SERVICE IPs
# ============================================================
ip_nginx: {{ ip_nginx | default('10.255.0.10') }}
ip_bind9: {{ ip_bind9 | default('10.255.0.30') }}
ip_stepca: {{ ip_stepca | default('10.255.0.40') }}
ip_ldap: {{ ip_ldap | default('10.255.0.50') }}
ip_keycloak: {{ ip_keycloak | default('10.255.0.60') }}
ip_postgres: {{ ip_postgres | default('10.255.0.70') }}
ip_webui: {{ ip_webui | default('10.255.0.80') }}
ip_openbao: {{ ip_openbao | default('10.255.0.90') }}

# ============================================================
# SERVICE HOSTNAMES
# ============================================================
cname_ca: {{ cname_ca | default('ca') }}
landing_page_cname: {{ landing_page_cname | default('', true) }}
cname_dns: {{ cname_dns | default('dns') }}
cname_ldap: {{ cname_ldap | default('ldap') }}
cname_sso: {{ cname_sso | default('sso') }}
cname_mgr: {{ cname_mgr | default('fabric') }}
cname_certs: {{ cname_certs | default('certs') }}
cname_openbao: {{ cname_openbao | default('vault') }}
{# The web UI's address: any host name (default fabric.<domain>). Outside the
   domain, fabric issues its certificate but you point DNS at this host. #}
webui_hostname: {{ webui_hostname | default('', true) }}

hostname_nginx: {{ hostname_nginx | default('nginx.' ~ domain) }}
hostname_bind9: {{ hostname_bind9 | default((cname_dns | default('dns')) ~ '.' ~ domain) }}
hostname_stepca: {{ hostname_stepca | default((cname_ca | default('ca')) ~ '.' ~ domain) }}
hostname_landing: {{ hostname_landing | default((landing_page_cname ~ '.' ~ domain) if landing_page_cname | default('', true) else domain) }}
hostname_ldap: {{ hostname_ldap | default((cname_ldap | default('ldap')) ~ '.' ~ domain) }}
hostname_keycloak: {{ hostname_keycloak | default((cname_sso | default('sso')) ~ '.' ~ domain) }}
{% set _hostname_mgr = (webui_hostname | default('', true) or ((cname_mgr | default('fabric')) ~ '.' ~ domain)) | lower %}
hostname_mgr: {{ _hostname_mgr }}
{# CA certificates for every system (certs.<domain>); ca.<domain> is Step-CA's API. #}
hostname_certs: {{ ((cname_certs | default('certs')) ~ '.' ~ domain) | lower }}
hostname_openbao: {{ ((cname_openbao | default('vault')) ~ '.' ~ domain) | lower }}
hostname_radius: {{ ((cname_radius | default('radius')) ~ '.' ~ domain) | lower }}
hostname_adguard: {{ ((cname_adguard | default('adguard')) ~ '.' ~ domain) | lower }}
{# The federation endpoint (design federation.md §5): sites join this install through it. Off until
   `fabricctl federation enable`; the name is always computed. #}
federation_endpoint: {{ federation_endpoint | default(false) | bool | lower }}
hostname_federation: {{ ((cname_federation | default('federation')) ~ '.' ~ domain) | lower }}

# ============================================================
# DOCKER IMAGES
# ============================================================
{# Defaults: the validated images, pinned by digest (fabric/images.lock.yaml). A host keeps
   the images it runs across fabric upgrades; `fabricctl images update` moves it to this list. #}
image_nginx: {{ image_nginx | default(images_lock.nginx) }}
{# stepca and keycloak run thin local layers built FROM these (fabric/jinja/<svc>/build). #}
image_stepca: {{ image_stepca | default(images_lock.stepca) }}
image_keycloak: {{ image_keycloak | default(images_lock.keycloak) }}
image_postgres: {{ image_postgres | default(images_lock.postgres) }}
image_openbao: {{ image_openbao | default(images_lock.openbao) }}
image_fluentbit: {{ image_fluentbit | default(images_lock.fluentbit) }}
image_adguard: {{ image_adguard | default(images_lock.adguard) }}
image_oauth2proxy: {{ image_oauth2proxy | default(images_lock.oauth2proxy) }}
{# Base of the locally built bind9, dirsrv and webui images (Debian packages). #}
image_debian: {{ image_debian | default(images_lock.debian) }}
{# Names of the locally built images (not pulled). #}
image_dirsrv: {{ image_dirsrv | default('fabric/dirsrv:local') }}
image_webui: {{ image_webui | default('fabric/web:local') }}
image_kea: {{ image_kea | default('fabric/kea:local') }}
image_freeradius: {{ image_freeradius | default('fabric/freeradius:local') }}
{# image_* keys the admin set explicitly: `fabricctl images update` leaves them alone. #}
image_pins: {{ image_pins | default([], true) | to_json }}
# After `fabricctl images update`: remove old images of fabric's repositories (never the rollback one).
image_prune: {{ image_prune | default(true) | bool }}

install_ldap: {{ install_ldap | default(true) | bool }}
# OpenBao (secrets) is core. Its unlock methods (slots.json) and their key files / token PINs, root-only.
openbao_key_dir: {{ openbao_key_dir | default('/etc/fabric/openbao') }}
# RAM-only: fabric-unlock puts the vault key here just before OpenBao starts, then wipes it.
openbao_runtime_dir: {{ openbao_runtime_dir | default('/run/fabric/openbao') }}
# RAM-only: OpenBao's break-glass socket (generate-root), root and the openbao user only.
openbao_admin_dir: {{ openbao_admin_dir | default('/run/fabric/openbao-admin') }}
openbao_seal_key_id: {{ openbao_seal_key_id | default('fabric-1') }}
openbao_mem_limit: {{ openbao_mem_limit | default('256m') }}
# PKCS#11 libraries fabric may load for security-key unlock methods (paths or globs; they run as root).
# Empty: ykcs11 (YubiKey), OpenSC and SoftHSM2 at their Debian/Ubuntu paths.
openbao_pkcs11_modules: {{ openbao_pkcs11_modules | default([], true) | to_json }}
# Recovery keys shown once at init (needed for a new root token or a seal migration).
openbao_recovery_shares: {{ openbao_recovery_shares | default(1) }}
openbao_recovery_threshold: {{ openbao_recovery_threshold | default(1) }}
install_keycloak: {{ install_keycloak | default(false) | bool }}
# Log forwarding (optional, design D20): Fluent Bit sends the host journal (all fabric
# containers and fabric's audit log) and OpenBao's audit log to syslog and/or Elasticsearch.
install_fluentbit: {{ install_fluentbit | default(false) | bool }}
# DHCP (optional, design §5): Kea 3.0 LTS on the host network; lease hostnames go
# to their own dynamic zone <ddns_subdomain>.<domain> (D16).
install_kea: {{ install_kea | default(false) | bool }}
ip_kea_ddns: {{ ip_kea_ddns | default('10.255.0.97') }}
kea_mem_limit: {{ kea_mem_limit | default('128m') }}
# interfaces: host interfaces to serve; subnets: [{subnet, pools: ["a - b"], routers,
# reservations: [{mac, ip, hostname}]}]; ddns (true), ddns_subdomain (dhcp), lease_time (s), dns
dhcp: {{ dhcp | default({}, true) | to_json }}
# 802.1X (optional, design §6): FreeRADIUS 3.2 checks each device against 389-DS
# (EAP-TLS by linked certificate, MAB by MAC) and returns its role's VLAN.
install_freeradius: {{ install_freeradius | default(false) | bool }}
ip_freeradius: {{ ip_freeradius | default('10.255.0.98') }}
freeradius_mem_limit: {{ freeradius_mem_limit | default('128m') }}
# The switches and access points that ask: [{name, address (IP or CIDR), message_authenticator (true)}].
# Each one's shared secret is generated and kept in OpenBao (fabricctl secrets show radius_secrets).
radius_clients: {{ radius_clients | default([], true) | to_json }}
# People who may join by password (EAP-TTLS): members of these directory groups only,
# [{group, vlan (optional), priority (100; lower wins)}]. Empty: no password logins.
# Default: the two network groups (empty at first), no VLAN yet; an empty list stays empty.
radius_people: {{ radius_people | default([{'group': 'network-staff', 'vlan': none, 'priority': 50},
                                          {'group': 'network-guests', 'vlan': none, 'priority': 100}]) | to_json }}
ip_fluentbit: {{ ip_fluentbit | default('10.255.0.95') }}
fluentbit_mem_limit: {{ fluentbit_mem_limit | default('64m') }}
# DNS filter (optional, design dns-filter.md): AdGuard Home in front of BIND on host_ip:53; BIND moves to
# bind_dns_port (5053). Clients ask AdGuard; AdGuard forwards fabric's domains to BIND and the rest over
# DNS-over-HTTPS/TLS. Its UI: https://adguard.<domain>, OIDC sign-in through oauth2-proxy.
dns_filter: {{ dns_filter | default('none', true) | lower }}
install_adguard: {{ (dns_filter | default('none', true) | lower) == 'adguard' }}
ip_adguard: {{ ip_adguard | default('10.255.0.31') }}
ip_oauth2proxy: {{ ip_oauth2proxy | default('10.255.0.32') }}
adguard_mem_limit: {{ adguard_mem_limit | default('256m') }}
# Out of the box AdGuard points at local DNS only (this site's BIND); the internet upstreams (DoH/DoT),
# bootstrap servers and filter lists are set up in AdGuard's UI after the OIDC sign-in and kept across
# deploys. These two only prefill a first deploy, e.g. [https://dns.google/dns-query, tls://dns.google]
# and [{name, url}] lists from https://adguardteam.github.io/HostlistsRegistry/.
adguard_upstreams: {{ adguard_upstreams | default([], true) | to_json }}
adguard_filter_lists: {{ adguard_filter_lists | default([], true) | to_json }}
# Rules after the generated ones (fabric's own domains and this host are always allowed first).
adguard_rules: {{ adguard_rules | default([], true) | to_json }}
# syslog: {host, port (6514), tls (true), ca_file}; elastic: {url, index, user, ca_file}.
# The Elasticsearch password lives in OpenBao: sudo fabricctl logs set-password elastic
log_forwarding: {{ log_forwarding | default({}, true) | to_json }}
# Web management UI (mTLS + Keycloak OIDC). Requires Keycloak.
install_webui: {{ (install_webui | default(true) | bool) and (install_keycloak | default(false) | bool) }}
webui_realm: {{ webui_realm | default(domain) }}
webui_admin_role: {{ webui_admin_role | default('fabric-admin') }}
webui_admin_group: {{ webui_admin_group | default('admins') }}
{# First web UI admin, created by `fabricctl setup` (LDAP user + client certificate). #}
webui_admin_user: {{ webui_admin_user | default('fabricadmin', true) }}
webui_admin_email: {{ webui_admin_email | default('', true) }}
webui_client_cert_days: {{ webui_client_cert_days | default(365) }}

# ============================================================
# SECURITY (fabricctl setup; relaxations are shown by fabricctl status)
# ============================================================
{% set _security = {'firewall': true, 'firewall_allow': [], 'docker_daemon_hardening': true} %}
{% set _ = _security.update(security | default({}, true)) %}
security:
{{ _security | to_nice_yaml(indent=2) | indent(2, first=True) }}

# ============================================================
# DOCKER / SERVICE INFRASTRUCTURE
# ============================================================
host_ram_capacity: {{ host_ram_capacity | default(0) }}
compose_file: {{ compose_file | default((deploy_base_dir | default('/opt')) ~ '/fabric/docker-compose.yml') }}
keycloak_data_dir: {{ keycloak_data_dir | default((deploy_base_dir | default('/opt')) ~ '/keycloak/data') }}
postgres_data_dir: {{ postgres_data_dir | default((deploy_base_dir | default('/opt')) ~ '/postgres/data') }}
{# Optional containers are derived from the install_* flags on every render, so
   strip them from any value read back from a previously rendered vars.yaml. #}
{% set _optional_containers = ['dirsrv', 'keycloak', 'postgres', 'webui', 'fabric-web'] %}
{% set _containers = (project_containers | default(['nginx', 'step-ca', 'bind9', 'openbao'])) | reject('in', _optional_containers) | list %}
{% if 'openbao' not in _containers %}{% set _ = _containers.append('openbao') %}{% endif %}
{% if install_ldap | default(true) | bool %}{% set _ = _containers.append('dirsrv') %}{% endif %}
{% if install_keycloak | default(false) | bool %}{% set _ = _containers.extend(['keycloak', 'postgres']) %}{% endif %}
{% if (install_webui | default(true) | bool) and (install_keycloak | default(false) | bool) %}{% set _ = _containers.append('fabric-web') %}{% endif %}
project_containers:
{{ _containers | unique | list | to_nice_yaml(indent=2) | indent(2, first=True) }}
{% set default_service_dirs = [
  { 'folder': 'nginx', 'owner': 'nginx' },
  { 'folder': 'bind9', 'owner': 'bind' },
  { 'folder': 'stepca', 'owner': 'step' },
  { 'folder': 'dirsrv', 'owner': 'ldap' },
  { 'folder': 'keycloak', 'owner': 'keycloak' },
  { 'folder': 'postgres', 'owner': 'postgres' },
  { 'folder': 'webui', 'owner': 'root' },
  { 'folder': 'openbao', 'owner': 'openbao' }
] %}
{# Built-in folders always come from the defaults above; user-added folders are kept. #}
{% set _default_folders = default_service_dirs | map(attribute='folder') | list %}
service_dirs:
{{ (default_service_dirs + ((service_dirs | default([])) | rejectattr('folder', 'in', _default_folders) | list)) | to_nice_yaml(indent=2) | indent(2, first=True) }}
{% set default_service_users = {
  'bind': {'uid': 53, 'gid': 53},
  'ldap': {'uid': 911, 'gid': 911},
  'nginx': {'uid': 443, 'gid': 443},
  'step': {'uid': 135, 'gid': 135},
  'keycloak': {'uid': 900, 'gid': 0},
  'postgres': {'uid': 901, 'gid': 901},
  'webui': {'uid': 912, 'gid': 912},
  'openbao': {'uid': 913, 'gid': 913},
  'fluentbit': {'uid': 914, 'gid': 914},
  'kea': {'uid': 915, 'gid': 915},
  'freeradius': {'uid': 916, 'gid': 916},
  'adguard': {'uid': 917, 'gid': 917},
  'oauth2proxy': {'uid': 918, 'gid': 918}
} %}
{# Merged, not defaulted: a vars.yaml rendered by an older release must still gain new accounts. #}
service_users:
{{ default_service_users | combine(service_users | default({})) | to_nice_yaml(indent=2) | indent(2, first=True) }}

# ============================================================
# CERTIFICATES / PKI
# ============================================================
byoc: {{ byoc | default(false) }}
ca_crt_path: {{ ca_crt_path | default('/home/default_admin/output/root_ca.crt') }}
ica_crt_path: {{ ica_crt_path | default('/home/default_admin/output/ica.crt') }}
{% if ica_key_path is defined and ica_key_path | length > 0 %}
ica_key_path: {{ ica_key_path }}
{% endif %}
{# Federation (design federation.md §6): a nested site's parent CAs (setup --join stages them) and how many
   there are; how many levels of sites may nest below a site, decided when this install makes its own root. #}
{% if ica_parents_path is defined and ica_parents_path | length > 0 %}
ica_parents_path: {{ ica_parents_path }}
{% endif %}
site_ca_depth: {{ site_ca_depth | default(0) | int }}
ca_nest_depth: {{ ca_nest_depth | default(1) | int }}
ca_name: {{ ca_name | default(friendly_name ~ ' CA') }}
cert_country: {{ cert_country | default('US') }}
cert_province: {{ cert_province | default('State') }}
cert_city: {{ cert_city | default('City') }}
cert_org: {{ cert_org | default(friendly_name) }}
cert_ou: {{ cert_ou | default('IT') }}
cert_root_ca_days: {{ cert_root_ca_days | default(1825) }}
cert_root_digest: {{ cert_root_digest | default('sha512') }}
cert_root_key_type: {{ cert_root_key_type | default('rsa') }}
cert_root_key_param: {{ cert_root_key_param | default(4096) }}
cert_intermediate_days: {{ cert_intermediate_days | default(1095) }}
cert_intermediate_digest: {{ cert_intermediate_digest | default('sha512') }}
cert_intermediate_key_type: {{ cert_intermediate_key_type | default('rsa') }}
cert_intermediate_key_param: {{ cert_intermediate_key_param | default(4096) }}
cert_service_days: {{ cert_service_days | default(365) }}
# Longest validity the web UI's Step-CA tab issues (CSR signing, generated key pairs).
pki_manual_max_days: {{ pki_manual_max_days | default(1825) }}

# ============================================================
# STEP-CA
# ============================================================
stepca_port: {{ stepca_port | default(9000) }}
stepca_cert_allow_subordinate_ca: {{ stepca_cert_allow_subordinate_ca | default(true) | lower }}
stepca_cert_max_lifetime_hours: "{{ stepca_cert_max_lifetime_hours | default((cert_service_days | default(365) * 24) ~ 'h') }}"
cert_acme_lifetime_hours: {{ cert_acme_lifetime_hours | default('720h') }}

# ============================================================
# DNS — BIND9
# ============================================================
{# With the DNS filter on, AdGuard answers clients on 53, so BIND can never be there: 53 becomes 5053
   (dns-filter.md). With it off the port is kept as set (e.g. 5053 behind an AdGuard of your own). #}
{% set _bind_port = (bind_dns_port | default(53, true)) | int %}
bind_dns_port: {{ 5053 if (dns_filter | default('none', true) | lower) == 'adguard' and _bind_port == 53 else _bind_port }}
bind9_doh_port: {{ bind9_doh_port | default(8053) }}
{% set _fabric_subnet = fabric_subnet | default('10.255.0.0/24') %}
{% set default_acls = {
  'acme-updaters': [_fabric_subnet],
  'dns-resolvers': ['127.0.0.1', lan_cidr, _fabric_subnet]
} %}
{% set final_bind_acls = default_acls %}
{% if bind_acls is defined %}
{% for k, v in bind_acls.items() %}
{% set filtered_v = [] %}
{% for item in v %}
{% if item == '{{ fabric_subnet }}' %}
{% set _ = filtered_v.append(_fabric_subnet) %}
{% else %}
{% set _ = filtered_v.append(item) %}
{% endif %}
{% endfor %}
{% if k in final_bind_acls %}
{% set _ = final_bind_acls.update({k: (final_bind_acls[k] + filtered_v) | unique | list}) %}
{% else %}
{% set _ = final_bind_acls.update({k: filtered_v}) %}
{% endif %}
{% endfor %}
{% endif %}
bind_acls:
{{ final_bind_acls | to_nice_yaml(indent=2) | indent(2, first=True) }}
{# Update policies inherited by every TSIG key in the ACL (fabricctl acl policy). #}
bind_acl_policies:
{{ bind_acl_policies | default({}, true) | to_nice_yaml(indent=2) | indent(2, first=True) }}
{% set default_cnames = [
  { 'canonical': hostname, 'name': cname_ca | default('ca') },
  { 'canonical': hostname, 'name': cname_dns | default('dns') },
  { 'canonical': hostname, 'name': cname_ldap | default('ldap') },
  { 'canonical': hostname, 'name': cname_sso | default('sso') },
  { 'canonical': hostname, 'name': cname_openbao | default('vault') }
] %}
{% if (cname_certs | default('certs')) != hostname %}
{% set _ = default_cnames.append({ 'canonical': hostname, 'name': cname_certs | default('certs') }) %}
{% endif %}
{# The web UI name gets a CNAME only inside this domain, and not when it is the
   host's own name (that already has an A record). #}
{% set _mgr_label = _hostname_mgr[:-(domain | length) - 1] if _hostname_mgr.endswith('.' ~ domain) else '' %}
{% if (install_webui | default(true) | bool) and (install_keycloak | default(false) | bool) and _mgr_label and _mgr_label != hostname %}
{% set _ = default_cnames.append({ 'canonical': hostname, 'name': _mgr_label }) %}
{% endif %}
{% if landing_page_cname | default('', true) %}
{% set _ = default_cnames.append({ 'canonical': hostname, 'name': landing_page_cname }) %}
{% endif %}
{% if federation_endpoint | default(false) | bool %}
{% set _ = default_cnames.append({ 'canonical': hostname, 'name': cname_federation | default('federation') }) %}
{% endif %}
{% if (dns_filter | default('none', true) | lower) == 'adguard' %}
{% set _ = default_cnames.append({ 'canonical': hostname, 'name': cname_adguard | default('adguard') }) %}
{% endif %}
{% set default_a = [
  { 'ip': host_ip, 'name': hostname }
] %}
{% if not landing_page_cname | default('', true) %}
{% set _ = default_a.append({ 'ip': host_ip, 'name': '@' }) %}
{% endif %}
{% set _user_dns = dns | default({'dynamic_zone_var': {'zone_authority': true}}) %}
{% set _dynamic_zone = _user_dns.get('dynamic_zone_var', {}) %}
{% set _merged_a = (_dynamic_zone.get('A', []) + default_a) | selectattr('name') | rejectattr('name', 'equalto', 'None') | unique | list %}
{% set _merged_cname = (_dynamic_zone.get('CNAME', []) + default_cnames) | selectattr('name') | rejectattr('name', 'equalto', 'None') | unique | list %}
{% set _ = _dynamic_zone.update({'A': _merged_a, 'CNAME': _merged_cname}) %}
{% set _ = _user_dns.update({'dynamic_zone_var': _dynamic_zone}) %}
dns:
{% for zone_key, zone_records in _user_dns.items() %}
  {{ zone_key }}:
{{ zone_records | to_nice_yaml(indent=4) | indent(4, first=True) }}
{% endfor %}
tsig_keys:
{{ tsig_keys | default([]) | to_nice_yaml(indent=2) | indent(2, first=True) }}

# ============================================================
# NGINX BACKENDS
# ============================================================
{# 389-DS terminates TLS itself; nginx only passes TCP through. #}
nginx_backend_ldap: {{ nginx_backend_ldap | default('dirsrv:3389', true) }}
nginx_backend_ldaps: {{ nginx_backend_ldaps | default('dirsrv:3636') }}
nginx_backend_stepca: {{ nginx_backend_stepca | default('https://step-ca:' ~ (stepca_port | default(9000))) }}

# ============================================================
# LDAP — the organisation's base DN and this site's part
# ============================================================
{# The organisation's domain: this install's own domain unless it joined an upstream (design
   federation.md), whose organisation it then shares. Names the organisation suffix; fixed once
   installed (setup refuses a change). #}
{% set _org_domain = (org_domain | default(domain, true)) | lower %}
org_domain: {{ _org_domain }}
{# The organisation's base DN: chosen when the root site is installed (e.g. dc=lan), else one dc= per label
   of org_domain; a site gets its upstream's. Fixed once installed (setup refuses a change). #}
{% set _base_dn = ((ldap_base_dn | default('', true)) or (_org_domain.split('.') | map('regex_replace', '^', 'dc=') | join(','))) | lower %}
ldap_base_dn: {{ _base_dn }}
# This install's site (design federation.md): names its local directory suffix, which holds this
# install's service accounts and its devices (the organisation suffix above holds people, groups and
# device roles). Defaults to the host name; fixed once installed (setup refuses a change).
site_name: {{ (site_name | default(hostname, true)) | lower }}
ldap_local_dn: ou={{ (site_name | default(hostname, true)) | lower }},{{ _base_dn }}

{# `bundle`: the fabric role bundle Keycloak grants to members (design D19); admins get
   webui_admin_role through webui_admin_group. #}
{% set default_ldap_groups = [
  { 'gidNumber': 1100, 'name': 'admins', 'permissions': ['read', 'write', 'modify'] },
  { 'gidNumber': 1110, 'name': 'auditors', 'bundle': 'fabric-auditor' },
  { 'gidNumber': 1111, 'name': 'network-operators', 'bundle': 'fabric-network-operator' },
  { 'gidNumber': 1112, 'name': 'equipment-operators', 'bundle': 'fabric-equipment-operator' },
  { 'gidNumber': 1113, 'name': 'pki-operators', 'bundle': 'fabric-pki-operator' },
