# fabric's own schema: devices and their access roles (RBAC).
# OID arc 2.25.204492767351757179914238406906488345409 (a UUID OID,
# ITU-T X.667: needs no registration). .1.x attribute types, .2.x classes.
# seed.py adds a definition only when its OID is missing; to change one,
# give it a new OID.
#
#   device (structural, cn/owner/description/serialNumber)
#     + ieee802Device (macAddress)  + fabricDevice (type, enabled, cert fingerprints)
#     + fabricDeviceRoles (fabricRoleName: the roles it belongs to)
#   groupOfNames (cn/description) + fabricRole (permissions, VLAN, priority)
#   fabricNetwork (cn, CIDR, site, VLAN, kind, overlap reason, description): a site's networks in
#     ou=networks of its part, and the whole address plan in ou=address-plan of the organisation
#   Devices live in the local suffix (o=<site>), roles in the organisation's; a role
#   no longer lists members (older installs are migrated: migrate_local_suffix.py).
dn: cn=schema
changetype: modify
add: attributeTypes
attributeTypes: ( 2.25.204492767351757179914238406906488345409.1.1 NAME 'fabricDeviceType' DESC 'fabric: kind of device (laptop, printer, iot, ...)' EQUALITY caseIgnoreMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE X-ORIGIN 'fabric' )
attributeTypes: ( 2.25.204492767351757179914238406906488345409.1.2 NAME 'fabricEnabled' DESC 'fabric: FALSE blocks the device whatever its roles grant' EQUALITY booleanMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.7 SINGLE-VALUE X-ORIGIN 'fabric' )
attributeTypes: ( 2.25.204492767351757179914238406906488345409.1.3 NAME 'fabricCertFingerprint' DESC 'fabric: SHA-256 fingerprint of a certificate issued to this device' EQUALITY caseIgnoreIA5Match SYNTAX 1.3.6.1.4.1.1466.115.121.1.26 X-ORIGIN 'fabric' )
attributeTypes: ( 2.25.204492767351757179914238406906488345409.1.4 NAME 'fabricPermission' DESC 'fabric: a permission a role grants its member devices' EQUALITY caseIgnoreMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 X-ORIGIN 'fabric' )
attributeTypes: ( 2.25.204492767351757179914238406906488345409.1.5 NAME 'fabricVlan' DESC 'fabric: VLAN a role places its member devices on (802.1X)' EQUALITY integerMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.27 SINGLE-VALUE X-ORIGIN 'fabric' )
attributeTypes: ( 2.25.204492767351757179914238406906488345409.1.6 NAME 'fabricPriority' DESC 'fabric: lower wins when roles set different VLANs' EQUALITY integerMatch ORDERING integerOrderingMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.27 SINGLE-VALUE X-ORIGIN 'fabric' )
attributeTypes: ( 2.25.204492767351757179914238406906488345409.1.7 NAME 'fabricRoleName' DESC 'fabric: a device role (cn in ou=device-roles of the organisation) this device belongs to' EQUALITY caseIgnoreMatch SUBSTR caseIgnoreSubstringsMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 X-ORIGIN 'fabric' )
attributeTypes: ( 2.25.204492767351757179914238406906488345409.1.8 NAME 'fabricSite' DESC 'fabric: the site a record belongs to' EQUALITY caseIgnoreMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE X-ORIGIN 'fabric' )
attributeTypes: ( 2.25.204492767351757179914238406906488345409.1.9 NAME 'fabricCidr' DESC 'fabric: an IPv4 network in CIDR form (192.168.20.0/24)' EQUALITY caseIgnoreIA5Match SYNTAX 1.3.6.1.4.1.1466.115.121.1.26 SINGLE-VALUE X-ORIGIN 'fabric' )
attributeTypes: ( 2.25.204492767351757179914238406906488345409.1.10 NAME 'fabricNetworkKind' DESC 'fabric: what a network is to its site (lan, dhcp)' EQUALITY caseIgnoreMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE X-ORIGIN 'fabric' )
attributeTypes: ( 2.25.204492767351757179914238406906488345409.1.11 NAME 'fabricAllowOverlap' DESC 'fabric: why this network may overlap another site (never routed together)' EQUALITY caseIgnoreMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE X-ORIGIN 'fabric' )
-
add: objectClasses
objectClasses: ( 2.25.204492767351757179914238406906488345409.2.1 NAME 'fabricDevice' DESC 'fabric: a device on the network' SUP top AUXILIARY MAY ( fabricDeviceType $ fabricEnabled $ fabricCertFingerprint ) X-ORIGIN 'fabric' )
objectClasses: ( 2.25.204492767351757179914238406906488345409.2.2 NAME 'fabricRole' DESC 'fabric: what member devices may do' SUP top AUXILIARY MAY ( fabricPermission $ fabricVlan $ fabricPriority ) X-ORIGIN 'fabric' )
objectClasses: ( 2.25.204492767351757179914238406906488345409.2.3 NAME 'fabricDeviceRoles' DESC 'fabric: the roles a device belongs to (the device names them, so a site can use roles it only has a read-only copy of)' SUP top AUXILIARY MAY ( fabricRoleName ) X-ORIGIN 'fabric' )
objectClasses: ( 2.25.204492767351757179914238406906488345409.2.4 NAME 'fabricNetwork' DESC 'fabric: a network of a site, for the address plan across sites (dhcp-management.md)' SUP top STRUCTURAL MUST ( cn $ fabricCidr ) MAY ( fabricSite $ fabricVlan $ fabricNetworkKind $ fabricAllowOverlap $ description ) X-ORIGIN 'fabric' )
