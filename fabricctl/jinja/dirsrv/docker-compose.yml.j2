services:
  dirsrv:
    image: {{ image_dirsrv }}
    build:
      context: {{ deploy_base_dir }}/dirsrv/build
      args:
        BASE_IMAGE: "{{ image_debian }}"
        DS_UID: "{{ service_users.ldap.uid }}"
        DS_GID: "{{ service_users.ldap.gid }}"
    container_name: dirsrv
    # to the host journal (fabric-web, openbao, … by name): `docker logs` still works,
    # and the optional log forwarder reads everything from one place
    logging:
      driver: journald
      options:
        tag: "{{ '{{.Name}}' }}"
    user: "{{ service_users.ldap.uid }}:{{ service_users.ldap.gid }}"
    read_only: true
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    tmpfs:
      - /tmp:noexec,nosuid,size=16m
      - /run:uid={{ service_users.ldap.uid }},gid={{ service_users.ldap.gid }},size=4m
    environment:
      DS_SUFFIX_NAME: "{{ ldap_base_dn }}"
      DS_LOCAL_SUFFIX: "{{ ldap_local_dn }}"        # this install's service accounts and devices
      DS_DM_PASSWORD: "{{ ldap_admin_password }}"
      DS_ERRORLOG_LEVEL: "{{ dirsrv_errorlog_level | default(8192) }}"
{% if (host_ram_capacity | default(0) | int) >= 3 and (host_ram_capacity | default(0) | int) <= 4 %}
      DS_MEMORY_PERCENTAGE: "10"
{% endif %}
    volumes:
      # /data holds config, db, logs and the TLS material in /data/tls
      # (server.crt, server.key, ca/*.crt) that dscontainer imports on start.
      - {{ deploy_base_dir }}/dirsrv/data:/data
      - {{ deploy_base_dir }}/dirsrv/seed:/seed:ro
    networks:
      fabric_net:
        ipv4_address: "{{ ip_ldap }}"
        aliases:
          - "{{ hostname_ldap }}"
{% if (host_ram_capacity | default(0) | int) >= 3 and (host_ram_capacity | default(0) | int) <= 4 %}
{% set ldap_mem = 256 if (host_ram_capacity | default(0) | int) == 3 else 384 %}
    deploy:
      resources:
        limits:
          memory: {{ ldap_mem }}M
{% endif %}
    healthcheck:
      test: ["CMD", "/usr/libexec/dirsrv/dscontainer", "-H"]
      interval: 15s
      timeout: 10s
      retries: 5
      start_period: 120s

networks:
  fabric_net:
    name: fabric_net
    external: true
