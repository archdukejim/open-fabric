services:
  adguardhome:
    # The DNS filter in front of BIND (design dns-filter.md): clients ask it on host_ip:53, it forwards
    # fabric's zones to BIND and the rest over DNS-over-HTTPS/TLS. Built FROM the pinned digest without the
    # binary's file capabilities (build/Dockerfile): it runs with none, on 5300 inside; Docker publishes 53
    # to it. Its UI is reached only through nginx. The sign-in (oauth2-proxy) is a unit of its own
    # (jinja/adguard-auth): DNS never waits for, or goes down with, Keycloak or the sign-in.
    image: fabric/adguard:local
    build:
      context: {{ deploy_base_dir }}/adguard/build
      args:
        BASE_IMAGE: "{{ image_adguard }}"
    container_name: adguardhome
    logging:
      driver: journald
    user: "{{ service_users.adguard.uid }}:{{ service_users.adguard.gid }}"
    command: ["--no-check-update", "-c", "/opt/adguardhome/conf/AdGuardHome.yaml", "-w", "/opt/adguardhome/work"]
    read_only: true
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    tmpfs:
      - /tmp:size=16m,uid={{ service_users.adguard.uid }},gid={{ service_users.adguard.gid }}
    ports:
      - "{{ host_ip }}:53:5300/tcp"
      - "{{ host_ip }}:53:5300/udp"
    volumes:
      - {{ deploy_base_dir }}/adguard/conf:/opt/adguardhome/conf
      - {{ deploy_base_dir }}/adguard/work:/opt/adguardhome/work
    networks:
      fabric_net:
        ipv4_address: "{{ ip_adguard }}"
        aliases:
          - adguard
    mem_limit: {{ adguard_mem_limit }}
    healthcheck:
      test: ["CMD", "wget", "-q", "--spider", "http://127.0.0.1:3000/"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 15s

networks:
  fabric_net:
    name: fabric_net
    external: true
