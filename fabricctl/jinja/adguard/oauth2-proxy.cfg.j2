# oauth2-proxy in front of AdGuard Home's UI (design dns-filter.md §5). nginx asks /oauth2/auth before every
# request; the client secret and cookie secret come from secrets.env (OAUTH2_PROXY_CLIENT_SECRET,
# OAUTH2_PROXY_COOKIE_SECRET), never this file or argv.
http_address = "0.0.0.0:4180"
reverse_proxy = true
upstreams = ["static://202"]
provider = "oidc"
provider_display_name = "fabric sign-in"
oidc_issuer_url = "https://{{ hostname_keycloak }}/realms/{{ webui_realm }}"
# endpoints given, no discovery: oauth2-proxy then starts while Keycloak is down or still starting (it would exit
# otherwise); Keycloak's keys are fetched when the first sign-in is checked
skip_oidc_discovery = true
login_url = "https://{{ hostname_keycloak }}/realms/{{ webui_realm }}/protocol/openid-connect/auth"
redeem_url = "https://{{ hostname_keycloak }}/realms/{{ webui_realm }}/protocol/openid-connect/token"
oidc_jwks_url = "https://{{ hostname_keycloak }}/realms/{{ webui_realm }}/protocol/openid-connect/certs"
profile_url = "https://{{ hostname_keycloak }}/realms/{{ webui_realm }}/protocol/openid-connect/userinfo"
provider_ca_files = ["/etc/oauth2-proxy/root_ca.crt"]
client_id = "fabric-adguard"
redirect_url = "https://{{ hostname_adguard }}/oauth2/callback"
scope = "openid profile email"
# fabric's people may have no e-mail address: identify them by user name
user_id_claim = "preferred_username"
insecure_oidc_allow_unverified_email = true
email_domains = ["*"]
# realm roles arrive in the ID token's "roles" claim (fabric-adguard client); only this permission gets in
oidc_groups_claim = "roles"
allowed_groups = ["fabric:dns:filter"]
skip_provider_button = true
cookie_name = "_fabric_adguard"
cookie_secure = true
cookie_samesite = "lax"
cookie_domains = ["{{ hostname_adguard }}"]
whitelist_domains = ["{{ hostname_adguard }}"]
set_xauthrequest = true
