services:
  step-ca:
    # Thin local layer: drops the upstream binary's file capability so it can
    # run with no-new-privileges and no capabilities (see build/Dockerfile).
    image: fabric/stepca:local
    build:
      context: {{ deploy_base_dir }}/stepca/build
      args:
        BASE_IMAGE: "{{ image_stepca }}"
    container_name: step-ca
    # to the host journal (fabric-web, openbao, … by name): `docker logs` still works,
    # and the optional log forwarder reads everything from one place
    logging:
      driver: journald
      options:
        tag: "{{ '{{.Name}}' }}"
    user: "{{ service_users.step.uid }}:{{ service_users.step.gid }}"
    read_only: true
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    tmpfs:
      - /tmp:noexec,nosuid,size=8m
    dns:
      - {{ ip_bind9 }}
    volumes:
      - {{ deploy_base_dir }}/stepca/data:/home/step
    command:
      - /usr/local/bin/step-ca
      - /home/step/config/ca.json
      - --password-file
      - /home/step/secrets/password
    networks:
      fabric_net:
        ipv4_address: "{{ ip_stepca }}"
        aliases:
          - "{{ hostname_stepca }}"
{% if (host_ram_capacity | default(0) | int) >= 3 and (host_ram_capacity | default(0) | int) <= 4 %}
{% set stepca_mem = 30 if (host_ram_capacity | default(0) | int) == 3 else 50 %}
    deploy:
      resources:
        limits:
          memory: {{ stepca_mem }}M
{% endif %}
    healthcheck:
      test: ["CMD", "/usr/local/bin/step", "ca", "health", "--ca-url", "https://{{ hostname_stepca }}:{{ stepca_port }}", "--root", "/home/step/certs/root_ca.crt"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s

networks:
  fabric_net:
    name: fabric_net
    external: true
