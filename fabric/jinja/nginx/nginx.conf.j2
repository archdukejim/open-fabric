{# ----------------------------------------------------------------- #}
{# nginx.conf — rendered by fabricctl from nginx/nginx.conf.j2         #}
{# ----------------------------------------------------------------- #}

{# How the CA certificate files are served (certs.<domain> on 80 and 443, and
   http://<host_ip>/certs/): the MIME types operating systems recognise;
   .pem/.json readable in the browser, the rest downloads. #}
{% macro cert_file_types() %}
            location ~ \.pem$ {
                default_type text/plain;
                types { }
                charset utf-8;
            }
            location ~ \.json$ {
                default_type application/json;
                types { }
            }
            location ~ \.crt$ {
                default_type application/x-x509-ca-cert;
                types { }
                add_header Content-Disposition 'attachment' always;
                add_header X-Content-Type-Options nosniff always;
            }
            location ~ \.(cer|der)$ {
                default_type application/pkix-cert;
                types { }
                add_header Content-Disposition 'attachment' always;
                add_header X-Content-Type-Options nosniff always;
            }
            location ~ \.p7b$ {
                default_type application/x-pkcs7-certificates;
                types { }
                add_header Content-Disposition 'attachment' always;
                add_header X-Content-Type-Options nosniff always;
            }
            location ~ \.sh$ {
                default_type text/x-shellscript;
                types { }
                add_header Content-Disposition 'attachment' always;
                add_header X-Content-Type-Options nosniff always;
            }
{% endmacro %}

# Global settings
worker_processes  auto;
worker_rlimit_nofile 65535;
error_log  /var/log/nginx/error.log notice;
pid        /tmp/nginx.pid;

events {
    multi_accept on;
    worker_connections  16384;
}

# DNS / LDAP stream proxies
stream {
    resolver 127.0.0.11 valid=30s;

{% if install_ldap | default(true) | bool %}
    # 389 Directory Server terminates TLS itself, so both listeners are plain
    # TCP passthrough and the directory's certificate reaches the client.
    # LDAP (389): 389-DS rejects everything except StartTLS and the rootDSE
    # until the connection is encrypted (nsslapd-minssf).
    server {
        listen 389;
        set $ldap_backend "{{ nginx_backend_ldap }}";
        proxy_pass $ldap_backend;
        proxy_timeout 300s;
        proxy_connect_timeout 5s;
    }

    # LDAPS (636)
    server {
        listen 636;
        set $ldaps_backend "{{ nginx_backend_ldaps }}";
        proxy_pass $ldaps_backend;
        proxy_timeout 300s;
        proxy_connect_timeout 5s;
    }
{% endif %}
}

http {
    include       /etc/nginx/mime.types;
    include       /etc/nginx/conf.d/*.conf;
    default_type  application/octet-stream;

    # Non-root user (UID {{ service_users.nginx.uid }}) temp paths
    client_body_temp_path /tmp/client_temp;
    proxy_temp_path       /tmp/proxy_temp;
    fastcgi_temp_path     /tmp/fastcgi_temp;
    uwsgi_temp_path       /tmp/uwsgi_temp;
    scgi_temp_path        /tmp/scgi_temp;

    resolver 127.0.0.11 valid=30s;

    # HTTP — health check, CA certificates (/certs/), redirect everything else to HTTPS
    server {
        listen 80 default_server;
        server_name _;

        location /health {
            access_log off;
            return 200 'OK';
        }

        # CA certificates without DNS or TLS: http://<host_ip>/certs/
        location = /certs {
            return 301 /certs/;
        }
        location /certs/ {
            root /srv/www;
            index index.html;
{{ cert_file_types() }}        }
        location = /style.css {
            root /srv/www/shared;
        }

        location / {
            return 301 https://$host$request_uri;
        }
    }

    # HTTPS — DNS-over-HTTPS via BIND9
    # nginx terminates TLS; BIND9 serves plain HTTP DoH on port {{ bind9_doh_port }}.
    server {
        listen 443 ssl;
        server_name {{ hostname_bind9 }};

        ssl_certificate     /etc/nginx/certs/{{ hostname_bind9 }}/fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/{{ hostname_bind9 }}/privkey.pem;
        ssl_protocols       TLSv1.2 TLSv1.3;

        location /dns-query {
            set $bind9_doh_backend "http://bind9:{{ bind9_doh_port }}";
            proxy_pass $bind9_doh_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_http_version 1.1;
        }
    }

    # Step-CA — pass HTTPS through to Step-CA's native TLS on port {{ stepca_port }}
    server {
        listen 443 ssl;
        server_name {{ hostname_stepca }};

        ssl_certificate     /etc/nginx/certs/{{ hostname_stepca }}/fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/{{ hostname_stepca }}/privkey.pem;
        ssl_protocols       TLSv1.2 TLSv1.3;

        set $stepca_backend "{{ nginx_backend_stepca }}";

        # Step-CA's API / ACME only. People opening ca.<domain> in a browser
        # (or an old /certificates link) get the certificate page.
        location = / {
            return 302 https://{{ hostname_certs }}/;
        }
        location /certificates {
            return 301 https://{{ hostname_certs }}/;
        }

        location / {
            proxy_pass $stepca_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_ssl_verify off;
        }
    }

    # Fabric Landing Portal (Landing, Certificates, Manual)
    server {
        listen 443 ssl;
        server_name {{ hostname_landing }};

        ssl_certificate     /etc/nginx/certs/{{ hostname_landing }}/fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/{{ hostname_landing }}/privkey.pem;
        ssl_protocols       TLSv1.2 TLSv1.3;

        location = /style.css {
            alias /srv/www/shared/style.css;
        }

        location / {
            alias /srv/www/landing/;
            index index.html;
            default_type text/html;
        }

        location /manual/ {
            alias /srv/www/manual/;
            index index.html;
            default_type text/html;
        }

        location /ldap/ {
            alias /srv/www/ldap/;
            index index.html;
            default_type text/html;
        }

        location = /ldap/install-ldap-{{ domain_file }}.sh {
            alias /srv/www/ldap/install-ldap.sh;
            default_type text/x-shellscript;
            add_header Content-Disposition 'attachment; filename="install-ldap-{{ domain_file }}.sh"';
        }

        location /certificates {
            return 301 https://{{ hostname_certs }}/;
        }
    }

    # CA certificates for every kind of system (published by fabricctl setup:
    # fabriclib/pki/publish_ca_certs.py). Read-only static files, deliberately
    # also on plain HTTP: a client fetching the CA does not trust it yet.
    # Integrity: compare the fingerprints shown on the page.
    server {
        listen 80;
        listen 443 ssl;
        server_name {{ hostname_certs }};

        ssl_certificate     /etc/nginx/certs/{{ hostname_certs }}/fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/{{ hostname_certs }}/privkey.pem;
        ssl_protocols       TLSv1.2 TLSv1.3;

        root /srv/www/certs;
        index index.html;
        add_header X-Content-Type-Options nosniff always;

        location = /style.css {
            alias /srv/www/shared/style.css;
        }
        location / {
{{ cert_file_types() }}        }
    }

{% if install_keycloak | default(false) | bool %}
    # Keycloak Web UI / API
    server {
        listen 443 ssl;
        server_name {{ hostname_keycloak }};

        ssl_certificate /etc/nginx/certs/{{ hostname_keycloak }}/fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/{{ hostname_keycloak }}/privkey.pem;

        location / {
            set $keycloak_backend "https://keycloak:8443";
            proxy_pass $keycloak_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port 443;
            proxy_ssl_verify off;
        }
    }
{% endif %}
{% if install_webui | default(false) | bool %}

    # webui management UI — mutual TLS, then Keycloak OIDC in the app.
    server {
        listen 443 ssl;
        server_name {{ hostname_mgr }};

        ssl_certificate     /etc/nginx/certs/{{ hostname_mgr }}/fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/{{ hostname_mgr }}/privkey.pem;
        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_session_tickets off;

        # Only certificates issued directly by the Step-CA intermediate:
        # depth 2 = leaf -> intermediate -> root. Leaves under a subordinate
        # CA minted with --intermediate-ca are one level deeper and fail.
        ssl_client_certificate /etc/nginx/certs/client-ca/ca-bundle.pem;
        ssl_verify_client on;
        ssl_verify_depth 2;

        add_header Strict-Transport-Security "max-age=31536000" always;
        client_max_body_size 64k;

        location / {
            proxy_pass http://unix:/srv/webui/web.sock:;
            proxy_http_version 1.1;
            proxy_read_timeout 900s;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            # Always overwritten here, so a client can never supply them.
            proxy_set_header X-SSL-Client-Verify $ssl_client_verify;
            proxy_set_header X-SSL-Client-S-DN $ssl_client_s_dn;
            proxy_set_header X-SSL-Client-I-DN $ssl_client_i_dn;
            proxy_set_header X-SSL-Client-Fingerprint $ssl_client_fingerprint;
        }
    }
{% endif %}
}
