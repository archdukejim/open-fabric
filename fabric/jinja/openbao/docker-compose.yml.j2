services:
  openbao:
    # Pinned by digest: an upstream push never changes what runs.
    image: "{{ image_openbao }}"
    container_name: openbao
    user: "{{ service_users.openbao.uid }}:{{ service_users.openbao.gid }}"
    # `bao server` directly (the image's entrypoint chowns and setcaps, which
    # a capability-less, read-only container must not need); docker-init reaps.
    entrypoint: ["bao", "server", "-config=/openbao/config"]
    init: true
    read_only: true
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    tmpfs:
      - /tmp:noexec,nosuid,size=8m
    environment:
      BAO_ADDR: "https://127.0.0.1:8200"
      BAO_CACERT: /openbao/certs/root_ca.crt
      BAO_TLS_SERVER_NAME: "{{ hostname_openbao }}"
    dns:
      - {{ ip_bind9 }}
    volumes:
      - {{ deploy_base_dir }}/openbao/config:/openbao/config:ro
      - {{ deploy_base_dir }}/openbao/data:/openbao/data
      - {{ deploy_base_dir }}/openbao/logs:/openbao/logs
      - {{ deploy_base_dir }}/openbao/certs:/openbao/certs:ro
      # The vault key, only while OpenBao starts (fabric-unlock writes it to RAM,
      # wipes it once unsealed): readable by this container's user only.
      - {{ openbao_runtime_dir }}:/openbao/seal:ro
    networks:
      fabric_net:
        ipv4_address: "{{ ip_openbao }}"
        aliases:
          - "{{ hostname_openbao }}"
    mem_limit: {{ openbao_mem_limit }}
    # Healthy = unsealed, or not initialised yet (first start, before
    # `fabricctl setup` runs init). Initialised but sealed = unhealthy:
    # the seal key is missing or wrong. ($$: compose would expand $rc itself.)
    healthcheck:
      test: ["CMD-SHELL", "bao status >/dev/null 2>&1; rc=$$?; [ $$rc -eq 0 ] || { [ $$rc -eq 2 ] && bao status -format=json 2>/dev/null | grep -q '\"initialized\": false'; }"]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 20s

networks:
  fabric_net:
    name: fabric_net
    external: true
