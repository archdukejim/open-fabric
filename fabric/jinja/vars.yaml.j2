---
# ============================================================
# RESOLVED VARS — auto-generated by 01-render-jinja.yml
# Sources: /custom-vars.yaml
#
# Do not edit directly — regenerated on every run of 01-render-jinja.yml.
# To change settings edit the source files above.
# ============================================================

# ============================================================
# GLOBAL
# ============================================================
domain: {{ domain }}
domain_file: {{ domain_file | default(domain | replace('.', '_')) }}
hostname: {{ hostname }}
friendly_name: {{ friendly_name | default("Example Org", true) }}
service_mark: {{ service_mark | default('null', true) }}
care_of: {{ care_of | default('null', true) }}
trademark: {{ trademark | default('null', true) }}
copyright: {{ copyright | default('null', true) }}
contact_email: {{ contact_email | default('null', true) }}
contact_phone: {{ contact_phone | default('null', true) }}
address_line1: {{ address_line1 | default('null', true) }}
address_line2: {{ address_line2 | default('null', true) }}
system_timezone: {{ system_timezone | default('America/New_York') }}
deploy_base_dir: {{ deploy_base_dir | default('/opt') }}

# ============================================================
# NETWORK
# ============================================================
lan_cidr: {{ lan_cidr }}
lan_gateway: {{ lan_gateway }}
dns_server: {{ dns_server | default('8.8.8.8') }}
use_host_dns: {{ use_host_dns | default(true) | lower }}
{# core_subnet: pre-fabric name, still honoured #}
fabric_subnet: {{ fabric_subnet | default(core_subnet | default('10.255.0.0/24')) }}
host_ip: {{ host_ip }}

# ============================================================
# SERVICE IPs
# ============================================================
ip_nginx: {{ ip_nginx | default('10.255.0.10') }}
ip_bind9: {{ ip_bind9 | default('10.255.0.30') }}
ip_stepca: {{ ip_stepca | default('10.255.0.40') }}
ip_ldap: {{ ip_ldap | default('10.255.0.50') }}
ip_keycloak: {{ ip_keycloak | default('10.255.0.60') }}
ip_postgres: {{ ip_postgres | default('10.255.0.70') }}
ip_webui: {{ ip_webui | default('10.255.0.80') }}

# ============================================================
# SERVICE HOSTNAMES
# ============================================================
cname_ca: {{ cname_ca | default('ca') }}
landing_page_cname: {{ landing_page_cname | default('', true) }}
cname_dns: {{ cname_dns | default('dns') }}
cname_ldap: {{ cname_ldap | default('ldap') }}
cname_sso: {{ cname_sso | default('sso') }}
cname_mgr: {{ cname_mgr | default('mgr') }}

hostname_nginx: {{ hostname_nginx | default('nginx.' ~ domain) }}
hostname_bind9: {{ hostname_bind9 | default((cname_dns | default('dns')) ~ '.' ~ domain) }}
hostname_stepca: {{ hostname_stepca | default((cname_ca | default('ca')) ~ '.' ~ domain) }}
hostname_landing: {{ hostname_landing | default((landing_page_cname ~ '.' ~ domain) if landing_page_cname | default('', true) else domain) }}
hostname_ldap: {{ hostname_ldap | default((cname_ldap | default('ldap')) ~ '.' ~ domain) }}
hostname_keycloak: {{ hostname_keycloak | default((cname_sso | default('sso')) ~ '.' ~ domain) }}
hostname_mgr: {{ hostname_mgr | default((cname_mgr | default('mgr')) ~ '.' ~ domain) }}

# ============================================================
# DOCKER IMAGES
# ============================================================
image_nginx: {{ image_nginx | default('nginx:latest') }}
image_bind9: {{ image_bind9 | default('ubuntu/bind9:latest') }}
image_stepca: {{ image_stepca | default('smallstep/step-ca:latest') }}
{# Built locally from Debian packages (fabric/jinja/dirsrv/build); `fabricctl --update-containers` rebuilds it. #}
image_dirsrv: {{ image_dirsrv | default('fabric/dirsrv:local') }}
image_keycloak: {{ image_keycloak | default('keycloak/keycloak:latest') }}
image_postgres: {{ image_postgres | default('postgres:latest') }}
{# Built locally from fabric/jinja/webui/build (Debian + python3-jinja2). #}
image_webui: {{ image_webui | default('fabric/webui:local') }}
{# image_* keys set explicitly by the admin; kept across upgrades (others follow the release). #}
image_pins: {{ image_pins | default([], true) | to_json }}

install_ldap: {{ install_ldap | default(true) | bool }}
install_keycloak: {{ install_keycloak | default(false) | bool }}
# Web management UI (mTLS + Keycloak OIDC). Requires Keycloak.
install_webui: {{ (install_webui | default(true) | bool) and (install_keycloak | default(false) | bool) }}
webui_realm: {{ webui_realm | default(domain) }}
webui_admin_role: {{ webui_admin_role | default('fabric-admin') }}
webui_admin_group: {{ webui_admin_group | default('admins') }}
{# First web UI admin, created by `fabricctl setup` (LDAP user + client certificate). #}
webui_admin_user: {{ webui_admin_user | default('fabricadmin', true) }}
webui_admin_email: {{ webui_admin_email | default('', true) }}
webui_client_cert_days: {{ webui_client_cert_days | default(365) }}

# ============================================================
# SECURITY (fabricctl setup; relaxations are shown by fabricctl status)
# ============================================================
{% set _security = {'firewall': true, 'firewall_allow': [], 'docker_daemon_hardening': true} %}
{% set _ = _security.update(security | default({}, true)) %}
security:
{{ _security | to_nice_yaml(indent=2) | indent(2, first=True) }}

# ============================================================
# DOCKER / SERVICE INFRASTRUCTURE
# ============================================================
host_ram_capacity: {{ host_ram_capacity | default(0) }}
compose_file: {{ compose_file | default((deploy_base_dir | default('/opt')) ~ '/fabric/docker-compose.yml') }}
keycloak_data_dir: {{ keycloak_data_dir | default((deploy_base_dir | default('/opt')) ~ '/keycloak/data') }}
postgres_data_dir: {{ postgres_data_dir | default((deploy_base_dir | default('/opt')) ~ '/postgres/data') }}
{# Optional containers are derived from the install_* flags on every render, so
   strip them from any value read back from a previously rendered vars.yaml. #}
{% set _optional_containers = ['openldap', 'dirsrv', 'keycloak', 'postgres', 'webui'] %}
{% set _containers = (project_containers | default(['nginx', 'step-ca', 'bind9'])) | reject('in', _optional_containers) | list %}
{% if install_ldap | default(true) | bool %}{% set _ = _containers.append('dirsrv') %}{% endif %}
{% if install_keycloak | default(false) | bool %}{% set _ = _containers.extend(['keycloak', 'postgres']) %}{% endif %}
{% if (install_webui | default(true) | bool) and (install_keycloak | default(false) | bool) %}{% set _ = _containers.append('webui') %}{% endif %}
project_containers:
{{ _containers | unique | list | to_nice_yaml(indent=2) | indent(2, first=True) }}
{% set default_service_dirs = [
  { 'folder': 'nginx', 'owner': 'nginx' },
  { 'folder': 'bind9', 'owner': 'bind' },
  { 'folder': 'stepca', 'owner': 'step' },
  { 'folder': 'dirsrv', 'owner': 'ldap' },
  { 'folder': 'keycloak', 'owner': 'keycloak' },
  { 'folder': 'postgres', 'owner': 'postgres' },
  { 'folder': 'webui', 'owner': 'root' }
] %}
{# Built-in folders always come from the defaults above; user-added folders are kept. #}
{% set _default_folders = default_service_dirs | map(attribute='folder') | list + ['openldap'] %}
service_dirs:
{{ (default_service_dirs + ((service_dirs | default([])) | rejectattr('folder', 'in', _default_folders) | list)) | to_nice_yaml(indent=2) | indent(2, first=True) }}
{% set default_service_users = {
  'bind': {'uid': 53, 'gid': 53},
  'ldap': {'uid': 911, 'gid': 911},
  'nginx': {'uid': 443, 'gid': 443},
  'step': {'uid': 135, 'gid': 135},
  'keycloak': {'uid': 900, 'gid': 0},
  'postgres': {'uid': 901, 'gid': 901},
  'webui': {'uid': 912, 'gid': 912}
} %}
{# Merged, not defaulted: a vars.yaml rendered by an older release must still gain new accounts. #}
service_users:
{{ default_service_users | combine(service_users | default({})) | to_nice_yaml(indent=2) | indent(2, first=True) }}

# ============================================================
# CERTIFICATES / PKI
# ============================================================
byoc: {{ byoc | default(false) }}
root_cert_name: {{ root_cert_name | default('root_ca') }}
ca_crt_path: {{ ca_crt_path | default('/home/default_admin/output/root_ca.crt') }}
ica_crt_path: {{ ica_crt_path | default('/home/default_admin/output/ica.crt') }}
{% if ica_key_path is defined and ica_key_path | length > 0 %}
ica_key_path: {{ ica_key_path }}
{% endif %}
ca_name: {{ ca_name | default(friendly_name ~ ' CA') }}
cert_country: {{ cert_country | default('US') }}
cert_province: {{ cert_province | default('State') }}
cert_city: {{ cert_city | default('City') }}
cert_org: {{ cert_org | default(friendly_name) }}
cert_ou: {{ cert_ou | default('IT') }}
cert_root_ca_days: {{ cert_root_ca_days | default(1825) }}
cert_root_digest: {{ cert_root_digest | default('sha512') }}
cert_root_key_type: {{ cert_root_key_type | default('rsa') }}
cert_root_key_param: {{ cert_root_key_param | default(4096) }}
cert_intermediate_days: {{ cert_intermediate_days | default(1095) }}
cert_intermediate_digest: {{ cert_intermediate_digest | default('sha512') }}
cert_intermediate_key_type: {{ cert_intermediate_key_type | default('rsa') }}
cert_intermediate_key_param: {{ cert_intermediate_key_param | default(4096) }}
cert_service_days: {{ cert_service_days | default(365) }}

# ============================================================
# STEP-CA
# ============================================================
stepca_port: {{ stepca_port | default(9000) }}
stepca_cert_allow_subordinate_ca: {{ stepca_cert_allow_subordinate_ca | default(true) | lower }}
stepca_cert_max_lifetime_hours: "{{ stepca_cert_max_lifetime_hours | default((cert_service_days | default(365) * 24) ~ 'h') }}"
cert_acme_lifetime_hours: {{ cert_acme_lifetime_hours | default('720h') }}

# ============================================================
# DNS — BIND9
# ============================================================
bind_dns_port: {{ bind_dns_port | default(53) }}
bind9_doh_port: {{ bind9_doh_port | default(8053) }}
{% set _fabric_subnet = fabric_subnet | default(core_subnet | default('10.255.0.0/24')) %}
{% set default_acls = {
  'acme-updaters': [_fabric_subnet],
  'dns-resolvers': ['127.0.0.1', lan_cidr, _fabric_subnet]
} %}
{% set final_bind_acls = default_acls %}
{% if bind_acls is defined %}
{% for k, v in bind_acls.items() %}
{% set filtered_v = [] %}
{% for item in v %}
{% if item == '{{ fabric_subnet }}' %}
{% set _ = filtered_v.append(_fabric_subnet) %}
{% else %}
{% set _ = filtered_v.append(item) %}
{% endif %}
{% endfor %}
{% if k in final_bind_acls %}
{% set _ = final_bind_acls.update({k: (final_bind_acls[k] + filtered_v) | unique | list}) %}
{% else %}
{% set _ = final_bind_acls.update({k: filtered_v}) %}
{% endif %}
{% endfor %}
{% endif %}
bind_acls:
{{ final_bind_acls | to_nice_yaml(indent=2) | indent(2, first=True) }}
{% set default_cnames = [
  { 'canonical': hostname, 'name': cname_ca | default('ca') },
  { 'canonical': hostname, 'name': cname_dns | default('dns') },
  { 'canonical': hostname, 'name': cname_ldap | default('ldap') },
  { 'canonical': hostname, 'name': cname_sso | default('sso') }
] %}
{% if (install_webui | default(true) | bool) and (install_keycloak | default(false) | bool) %}
{% set _ = default_cnames.append({ 'canonical': hostname, 'name': cname_mgr | default('mgr') }) %}
{% endif %}
{% if landing_page_cname | default('', true) %}
{% set _ = default_cnames.append({ 'canonical': hostname, 'name': landing_page_cname }) %}
{% endif %}
{% set default_a = [
  { 'ip': host_ip, 'name': hostname }
] %}
{% if not landing_page_cname | default('', true) %}
{% set _ = default_a.append({ 'ip': host_ip, 'name': '@' }) %}
{% endif %}
{% set _user_dns = dns | default({'dynamic_zone_var': {'zone_authority': true}}) %}
{% set _dynamic_zone = _user_dns.get('dynamic_zone_var', {}) %}
{% set _merged_a = (_dynamic_zone.get('A', []) + default_a) | selectattr('name') | rejectattr('name', 'equalto', 'None') | unique | list %}
{% set _merged_cname = (_dynamic_zone.get('CNAME', []) + default_cnames) | selectattr('name') | rejectattr('name', 'equalto', 'None') | unique | list %}
{% set _ = _dynamic_zone.update({'A': _merged_a, 'CNAME': _merged_cname}) %}
{% set _ = _user_dns.update({'dynamic_zone_var': _dynamic_zone}) %}
dns:
{% for zone_key, zone_records in _user_dns.items() %}
  {{ zone_key }}:
{{ zone_records | to_nice_yaml(indent=4) | indent(4, first=True) }}
{% endfor %}
tsig_keys:
{{ tsig_keys | default([]) | to_nice_yaml(indent=2) | indent(2, first=True) }}

# ============================================================
# REVERSE DNS — auto-computed from A records in the dns: block
# ============================================================
reverse_zone_names:
{{ _user_dns.values() |
   selectattr('A', 'defined') |
   map(attribute='A') |
   flatten |
   map(attribute='ip') |
   select('match', '^\d+\.\d+\.\d+\.\d+$') |
   map('regex_replace', '^(\\d+)\\.(\\d+)\\.(\\d+)\\.\\d+$', '\\3.\\2.\\1.in-addr.arpa') |
   unique |
   list |
   to_nice_yaml(indent=2) |
   indent(2, first=True) }}
# ============================================================
# NGINX BACKENDS
# ============================================================
{# 389-DS terminates TLS itself; nginx only passes TCP through. #}
nginx_backend_ldap: {{ 'dirsrv:3389' if (nginx_backend_ldap | default('', true)).startswith('openldap') or not nginx_backend_ldap | default('', true) else nginx_backend_ldap }}
nginx_backend_ldaps: {{ nginx_backend_ldaps | default('dirsrv:3636') }}
nginx_backend_stepca: {{ nginx_backend_stepca | default('https://step-ca:' ~ (stepca_port | default(9000))) }}

# ============================================================
# LDAP / OPENLDAP — base DN computed from domain
# ============================================================
ldap_base_dn: {{ domain.split('.') | map('regex_replace', '^', 'dc=') | join(',') }}
ldap_domain_components:
{{ domain.split('.') | to_nice_yaml(indent=2) | indent(2, first=True) }}

{% set default_ldap_groups = [
  { 'gidNumber': 1100, 'name': 'admins', 'permissions': ['read', 'write', 'modify'] },
  { 'gidNumber': 5000, 'name': 'users', 'permissions': ['read'] }
] %}
{% set _merged_groups = (ldap_groups | default([]) + default_ldap_groups) | unique(attribute='name') | list %}
ldap_groups:
{{ _merged_groups | to_nice_yaml(indent=2) | indent(2, first=True) }}

{% set default_ldap_ous = [
  { 'name': 'accounts', 'description': 'User Accounts' },
  { 'name': 'groups', 'description': 'Security Groups' },
  { 'name': 'admins', 'description': 'Privileged accounts', 'parent': 'accounts', 'uid_range': '1101-1999' },
  { 'name': 'users', 'description': 'Regular User accounts', 'parent': 'accounts', 'uid_range': '5001-50000' },
  { 'name': 'hosts', 'description': 'Computer objects', 'uid_range': '2000-4900' }
] %}
{% set _merged_ous = (ldap_organizational_units | default([]) + default_ldap_ous) | unique(attribute='name') | list %}
ldap_organizational_units:
{{ _merged_ous | to_nice_yaml(indent=2) | indent(2, first=True) }}
